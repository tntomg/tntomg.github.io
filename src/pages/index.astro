---
// Language entry point: detects browser language or saved preference, then routes to /ru/ or /en/.
import '@fontsource-variable/geologica/shrp.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Алексей Пахалко / Aleksei Pakhalko</title>
    <meta name="description" content="Ведущий геолог / Senior Geologist: mapping, petrography, field data QA/QC, geological applications." />
    <link rel="alternate" hreflang="ru" href="/ru/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('preferred-lang');
          if (stored === 'en') {
            window.location.replace('/en/');
            return;
          }
          if (stored === 'ru') {
            window.location.replace('/ru/');
            return;
          }
        } catch (e) {}
        var lang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        if (/^ru\b|^be\b|^uk\b|^ky\b|^kk\b/i.test(lang)) {
          window.location.replace('/ru/');
        } else {
          window.location.replace('/en/');
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/ru/" />
    </noscript>
  </head>
  <body>
    <main class="entry">
      <h1>Алексей Пахалко / Aleksei Pakhalko</h1>
      <p>Персональный сайт ведущего геолога / Personal website of a Senior Geologist.</p>
      <div style="display: flex; gap: 12px; justify-content: center; margin-top: 16px; flex-wrap: wrap;">
        <a class="button button-primary" href="/ru/">Русская версия (RU)</a>
        <a class="button button-ghost" href="/en/">English version (EN)</a>
      </div>
    </main>
  </body>
</html>
