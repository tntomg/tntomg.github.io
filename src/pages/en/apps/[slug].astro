---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import CoreShowcase from '../../../components/CoreShowcase.astro';
import PetrographyShowcase from '../../../components/PetrographyShowcase.astro';
import { appPresentation } from '../../../data/app-presentations';

export async function getStaticPaths() {
  const products = (await getCollection('apps_en', ({ data }) => data.publicationState === 'published' && data.kind === 'product')).sort((a, b) => a.data.order - b.data.order);
  return products.map((app, index) => ({
    params: { slug: app.data.slug! },
    props: { app, next: products[(index + 1) % products.length] },
  }));
}

interface Props {
  app: CollectionEntry<'apps_en'>;
  next: CollectionEntry<'apps_en'>;
}
const { app, next } = Astro.props;
const { data } = app;
const isField = (data.slug ?? '').includes('field');
const isCore = app.id === 'rocksurv-core';
const isPetrography = app.id === 'rocksurv-petrography';
const presentation = appPresentation(data.slug!);

const caption: Record<string, string> = {
  field: 'Rocksurv Field interface on a rugged tablet: georeferenced GeoPackage layers, active observation session, and field navigation.',
  petrography: 'RockSurv Petrography Android screens: optical mineral identification and a thin-section atlas with PPL/XPL images.',
  core: 'Rocksurv Core rendering prototype: interactive geological strip log and lithology patterns.',
  classifier: 'Rocksurv Classifier smartphone interface: equal-area Schmidt net with intersection axis calculation (beta-axis) and IUGS Streckeisen QAPF double triangle.',
};
---
<BaseLayout title={`${data.title}: ${data.area.toLowerCase()} | Aleksei Pakhalko`} description={data.summary} active="apps" theme="night" lang="en">
  <article class="case shell">
    <nav class="crumbs" aria-label="Breadcrumb navigation"><a href="/en/">Home</a><span aria-hidden="true">/</span><a href="/en/#apps">Apps</a><span aria-hidden="true">/</span><span aria-current="page">{data.title}</span></nav>

    <header class="case-head">
      <div>
        <p class="app-stage">{data.stage}. {data.area}</p>
        <h1 style={`view-transition-name: app-${data.slug}`}>{data.title}</h1>
        <p class="case-lead">{data.summary}</p>
      </div>
      <dl class="case-facts">
        {data.specVersion && <div><dt>Specification</dt><dd>version {data.specVersion}</dd></div>}
        {data.stack && <div><dt>Tech Stack</dt><dd>{data.stack}</dd></div>}
        {data.statusNote && <div><dt>Stage</dt><dd>{data.statusNote}</dd></div>}
        <div><dt>Operation</dt><dd>{isCore ? 'Offline MVP architecture' : '100% Offline-First'}</dd></div>
        <div>
          <dt>Presentation</dt>
          <dd>
            <a href={`/en/presentations/${presentation.key}/`} class="case-pres-link">
              <Icon name="presentation" />
              <span>Open ({`${presentation.slides} slides`})</span>
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <figure class="case-figure" style={`view-transition-name: figure-${data.slug}`}>
      <div class="figure-pres-bar">
        <a href={`/en/presentations/${presentation.key}/`} class="figure-pres-btn">
          <Icon name="presentation" />
          <span>Interactive app presentation ({`${presentation.slides} slides`}) &rarr;</span>
        </a>
      </div>
      {isPetrography ? (<PetrographyShowcase lang="en" />) : isCore ? (<CoreShowcase lang="en" />) : isField ? (
        <a href="/en/presentations/field/" class="app-showcase-link" aria-label="Open interactive presentation of Rocksurv Field">
          <div class="showcase-device showcase-tablet">
            <div class="device-bezel">
              <div class="device-camera-dot"></div>
              <div class="device-screen">
                <img
                  src="/presentations/field/01-1280.webp"
                  srcset="/presentations/field/01-800.webp 800w, /presentations/field/01-1280.webp 1280w, /presentations/field/01-1920.webp 1920w"
                  sizes="(max-width: 900px) 92vw, 560px"
                  width="1280"
                  height="705"
                  alt="Rocksurv Field interface on a rugged field tablet: georeferenced GeoPackage layers, active observation session, and satellite navigation"
                  loading="lazy"
                  decoding="async"
                  class="tablet-screen-img"
                />
                <div class="device-screen-overlay"></div>
              </div>
              <div class="showcase-chip-photo">
                <img
                  src="/presentations/field/16-640.webp"
                  width="140"
                  height="90"
                  alt="Fieldwork with rugged tablet on outcrop"
                  loading="lazy"
                  decoding="async"
                />
                <div class="chip-text">
                  <span class="chip-title">On Field Traverse</span>
                  <span class="chip-sub">100% Offline-First</span>
                </div>
              </div>
            </div>
          </div>
        </a>
      ) : (
        <a href="/en/presentations/classifier/" class="app-showcase-link" aria-label="Open interactive presentation of Rocksurv Classifier">
          <div class="showcase-device showcase-dual">
            <div class="device-phone phone-primary">
              <div class="phone-screen-wrap">
                <span class="phone-tag">Schmidt Net (beta-axis)</span>
                <img
                  src="/presentations/classifier/08-1000.webp"
                  srcset="/presentations/classifier/08-600.webp 600w, /presentations/classifier/08-1000.webp 1000w, /presentations/classifier/08-1600.webp 1600w"
                  sizes="(max-width: 900px) 46vw, 280px"
                  width="600"
                  height="1200"
                  alt="Rocksurv Classifier: equal-area Schmidt net with intersection of S0 and Fault planes, poles and calculated beta-axis"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="device-phone phone-secondary">
              <div class="phone-screen-wrap">
                <span class="phone-tag">IUGS QAPF (Plutonic)</span>
                <img
                  src="/presentations/classifier/11-1000.webp"
                  srcset="/presentations/classifier/11-600.webp 600w, /presentations/classifier/11-1000.webp 1000w, /presentations/classifier/11-1600.webp 1600w"
                  sizes="(max-width: 900px) 46vw, 280px"
                  width="600"
                  height="1200"
                  alt="Rocksurv Classifier: Streckeisen QAPF double triangle classification with monzogranite field"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </a>
      )}
      <figcaption>{caption[isPetrography ? 'petrography' : isCore ? 'core' : isField ? 'field' : 'classifier']}</figcaption>
    </figure>

    <section class="case-section" aria-labelledby="problem">
      <h2 id="problem">The Problem</h2>
      <p>{data.problem}</p>
    </section>

    <section class="case-section" aria-labelledby="workflow">
      <h2 id="workflow">{isCore ? 'Intended Workflow' : 'Workflow'}</h2>
      <ol class="steps">{data.workflow.map((step) => <li><p>{step}</p></li>)}</ol>
    </section>

    {data.capabilities.length > 0 && (
      <section class="case-section" aria-labelledby="capabilities">
        <h2 id="capabilities">{isPetrography ? 'Application Features' : isCore ? 'Completed Engine and Development Plan' : 'Specification Scope'}</h2>
        <div class="caps">
          {data.capabilities.map((group) => (
            <div class="cap">
              <h3>{group.group}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <nav class="case-nav" aria-label="Other applications">
      <a href="/en/#apps"><Icon name="arrow-left" />All applications</a>
      {next.id !== app.id && <a href={`/en/apps/${next.data.slug}/`}>{next.data.title}<Icon name="arrow-right" /></a>}
    </nav>
  </article>
</BaseLayout>
