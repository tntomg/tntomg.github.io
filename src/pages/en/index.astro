---
import { getCollection } from 'astro:content';
import talkSizes from '../../data/talk-sizes.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import CoreShowcase from '../../components/CoreShowcase.astro';
import PetrographyShowcase from '../../components/PetrographyShowcase.astro';
import { appPresentation } from '../../data/app-presentations';

const published = <T extends { data: { publicationState: string } }>(entry: T) => entry.data.publicationState === 'published';
const experience = (await getCollection('experience_en', published)).sort((a, b) => a.data.order - b.data.order);
const apps = (await getCollection('apps_en', published)).sort((a, b) => a.data.order - b.data.order);
const products = apps.filter((app) => app.data.kind === 'product');
const practice = apps.filter((app) => app.data.kind === 'practice');
const credentials = await getCollection('credentials_en', published);
const byKind = (kind: string) => credentials.filter((item) => item.data.kind === kind).sort((a, b) => b.data.year.localeCompare(a.data.year));
const awards = byKind('award');
const certificates = byKind('certificate');
const education = byKind('education');
const papers = byKind('publication');
const talks = byKind('talk');

const cv = '/cv/Aleksei-Pakhalko-CV-EN-2026.pdf';

// "Pakhalko A. G." + detail -> one period between them, never two.
const joinSentences = (lead: string, detail?: string) => (detail ? `${lead}${lead.endsWith('.') ? '' : '.'} ${detail}` : lead);

// Presentations are published whole as PDFs; scripts/export_talks.py writes their sizes to talk-sizes.json.
const fileSize = (file: string) => {
  const bytes = (talkSizes as Record<string, number>)[file];
  if (!bytes) throw new Error(`Missing PDF ${file}. Run scripts/export_talks.py`);
  return `${(bytes / 1048576).toFixed(1)} MB`;
};

const skills: { icon: IconName; title: string; text: string }[] = [
  { icon: 'code', title: 'App Development & GIS', text: 'Mobile apps for fieldwork and automated data processing. Flutter and Dart, Kotlin and Android, VBA and Excel, SQL, API testing. ArcGIS: 2D and 3D, geodatabases.' },
  { icon: 'list-checks', title: 'Field Data & QA/QC', text: 'Field traverses, lithological and structural descriptions, alteration, sampling, core logging. Validation of observation logs for completeness, integrity and consistency.' },
  { icon: 'microscope', title: 'Geology & Petrography', text: 'Mapping at 1:100,000 and 1:50,000 scales, structural geology, transmitted and reflected light microscopy of rocks and ores, applied geochemistry, isotope data, metallogenic potential assessment.' },
  { icon: 'compass', title: 'Field Operations & Leadership', text: 'Traverse planning, task delegation, staff mentoring. Coordination of schedules, budgets and communication across multidisciplinary and international projects.' },
];

const figureCaption: Record<string, string> = {
  'field-flow': 'Rocksurv Field interface on a rugged field tablet: georeferenced GeoPackage layers, active observation session, and satellite navigation.',
  petrography: 'RockSurv Petrography Android screens: optical mineral identification and a thin-section atlas with PPL/XPL images.',
  core: 'Rocksurv Core rendering prototype: interactive geological strip log and lithology patterns.',
  stereonet: 'Rocksurv Classifier interfaces: equal-area Schmidt net with intersection axis calculation (beta-axis) and IUGS-standard Streckeisen QAPF double triangle.',
};
---
<BaseLayout
  title="Aleksei Pakhalko, Senior Geologist: Geology & App Development"
  description="Senior Geologist with field experience since 2008. Geological mapping, petrography, geochemical mineral exploration and development of geological applications."
  active="profile"
  lang="en"
>
  <section id="profile" aria-labelledby="hero-title">
    <div class="shell hero">
      <div class="hero-copy">
        <p class="hero-kicker">Senior Engineer at Karpinsky Institute. Leading a geological field team on the GMAS project in Saudi Arabia.</p>
        <h1 class="hero-title" id="hero-title"><span class="line"><span>Aleksei</span></span><span class="line"><span>Pakhalko</span></span></h1>
        <p class="hero-lead">I develop modern apps for geological fieldwork: field data collection, analysis and quality control.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#apps">Explore Apps</a>
          <a class="button button-ghost" href={cv} download><Icon name="download" class="icon-down" />Download CV</a>
        </div>
      </div>
      <figure class="hero-visual">
        <div class="portrait">
          <img src="/images/portrait-960.webp" srcset="/images/portrait-480.webp 480w, /images/portrait-960.webp 960w" sizes="(max-width: 900px) 88vw, 40vw" width="960" height="1440" alt="Aleksei Pakhalko, Senior Geologist, on the embankment in Saint Petersburg" fetchpriority="high" />
        </div>
        <div class="scope">
          <img class="thin" src="/images/scope-gabbronorite-960.webp" srcset="/images/scope-gabbronorite-480.webp 480w, /images/scope-gabbronorite-960.webp 826w" sizes="(max-width: 900px) 60vw, 26vw" width="826" height="579" alt="Thin section of altered gabbronorite under polarizing microscope, crossed polars" decoding="async" />
          <span class="scope-ring" aria-hidden="true"></span>
        </div>
      </figure>
    </div>

    <div class="shell profile">
      <div>
        <h2 data-reveal>What I do</h2>
        <p class="profile-about" data-reveal style="--i:1">I combine geological experience with app development. My focus is digital solutions for geological work, from collecting observations to data analysis and quality control. My task is to optimise the collection and validation of incoming geological information. I draw on field experience since 2008, from Karelia and Asian metallogeny to mapping the Arabian Shield. At Karpinsky Institute, I lead projects, write reports and examine rocks under the microscope.</p>
        <dl class="profile-facts" data-reveal style="--i:2">
          <div><dt>Fieldwork</dt><dd>since 2008</dd></div>
          <div><dt>Countries</dt><dd>Russia, China, Mongolia, Saudi Arabia</dd></div>
          <div><dt>Languages</dt><dd>Russian (native), English (Upper-Intermediate), Chinese (HSK 3)</dd></div>
          <div><dt>Education</dt><dd>Mining Institute, 2010; postgraduate studies at Karpinsky Institute (VSEGEI), 2010-2014</dd></div>
        </dl>
      </div>
      <ul class="skills">
        {skills.map((skill, index) => (
          <li class="skill" data-reveal style={`--i:${index}`}>
            <Icon name={skill.icon} />
            <div><h3>{skill.title}</h3><p>{skill.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="experience-title" data-reveal>Since 2008: From Karelia to the Arabian Shield</h2>
        <p data-reveal style="--i:1">Seven career stages, from current to earliest. Fieldwork photographs and project archives.</p>
      </div>
      <div class="strata">
        <nav class="column" aria-label="Career stages">
          <p class="column-title">Stratigraphic column</p>
          <ol>
            {experience.map((entry) => (
              <li>
                <a class={`layer pat-${entry.data.pattern}`} href={`#stage-${entry.id}`} data-layer={entry.id}>
                  <span class="layer-swatch" aria-hidden="true"></span>
                  <span class="layer-text"><small>{entry.data.period}</small><span>{entry.data.short}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="stages">
          {experience.map((entry) => {
            const { data } = entry;
            return (
              <article class:list={['stage', `pat-${data.pattern}`, { 'no-photos': data.photos.length === 0 }]} id={`stage-${entry.id}`} data-stage={entry.id} aria-labelledby={`stage-title-${entry.id}`}>
                <span class="stage-band" aria-hidden="true"></span>
                <p class="stage-meta" data-reveal><span class="num">{data.period}</span><span>{data.place}</span></p>
                <h3 id={`stage-title-${entry.id}`} data-reveal style="--i:1">{data.title}</h3>
                <p class="stage-org" data-reveal style="--i:2">{data.organization}</p>
                {data.role && <p class="stage-role" data-reveal style="--i:2">{data.role}</p>}
                <div class="stage-body">
                  {data.photos.length > 0 && <PhotoCarousel id={entry.id} label={`Photos: ${data.title}`} photos={data.photos} note={data.photoNote} lang="en" />}
                  <div class="stage-text" data-reveal style="--i:3">
                    <p class="stage-summary">{data.summary}</p>
                    <ul class="stage-points">{data.highlights.map((item) => <li>{item}</li>)}</ul>
                    {data.materials.length > 0 && (
                      <div class="stage-docs">
                        <h4><Icon name="certificate" />Documents & presentations</h4>
                        <ul>{data.materials.map((item) => <li>{item}</li>)}</ul>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="apps" id="apps" aria-labelledby="apps-title" data-scene-night>
    <div class="shell">
      <div class="section-head">
        <h2 id="apps-title" data-reveal>My Apps for Geologists</h2>
        <p data-reveal style="--i:1">I develop apps for field and laboratory work: maps and observations, rock classification, drill core documentation and optical mineral identification. Explore the interfaces and presentations of Rocksurv Field, Rocksurv Classifier, Rocksurv Core and RockSurv Petrography below.</p>
      </div>

      <ol class="route" data-reveal style="--i:2" aria-label="Workflow stages and applications">
        {products.map((app, index) => (
          <li><a href={`#app-${app.id}`}><span class="route-node">{String(index + 1).padStart(2, '0')}</span><small>{app.data.stage}</small><strong>{app.data.title}</strong></a></li>
        ))}
      </ol>

      {products.map((app, index) => {
        const isField = (app.data.slug ?? '').includes('field');
        const isCore = app.id === 'rocksurv-core';
        const isPetrography = app.id === 'rocksurv-petrography';
        const presentation = appPresentation(app.data.slug!);
        return (
          <article class:list={['app', { 'app-reverse': index % 2 === 1 }]} id={`app-${app.id}`} aria-labelledby={`app-title-${app.id}`}>
            {app.id === 'rocksurv-field' && <span id="app-fieldscan" class="visually-hidden"></span>}
            {isPetrography && <span id="app-rocksurf-petrography" class="visually-hidden" aria-hidden="true"></span>}
            <figure class="app-visual" data-reveal="scale" style={`view-transition-name: figure-${app.data.slug}`}>
              {isPetrography ? (<PetrographyShowcase lang="en" />) : isCore ? (<CoreShowcase lang="en" />) : isField ? (
                <a href="/en/presentations/field/" class="app-showcase-link" aria-label="Open interactive presentation of Rocksurv Field">
                  <div class="showcase-device showcase-tablet">
                    <div class="device-bezel">
                      <div class="device-camera-dot"></div>
                      <div class="device-screen">
                        <img
                          src="/presentations/field/01-1280.webp"
                          srcset="/presentations/field/01-800.webp 800w, /presentations/field/01-1280.webp 1280w, /presentations/field/01-1920.webp 1920w"
                          sizes="(max-width: 900px) 92vw, 560px"
                          width="1280"
                          height="705"
                          alt="Rocksurv Field interface on a rugged field tablet: georeferenced GeoPackage layers, active observation session, and satellite navigation"
                          loading="lazy"
                          decoding="async"
                          class="tablet-screen-img"
                        />
                        <div class="device-screen-overlay"></div>
                      </div>
                      <div class="showcase-chip-photo">
                        <img
                          src="/presentations/field/16-640.webp"
                          width="140"
                          height="90"
                          alt="Fieldwork with rugged tablet on outcrop"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="chip-text">
                          <span class="chip-title">On Field Traverse</span>
                          <span class="chip-sub">100% Offline-First</span>
                        </div>
                      </div>
                    </div>
                    <div class="showcase-badge-cta">
                      <span class="cta-pill">
                        <Icon name="presentation" />
                        Interactive presentation: 17 slides &rarr;
                      </span>
                    </div>
                  </div>
                </a>
              ) : (
                <a href="/en/presentations/classifier/" class="app-showcase-link" aria-label="Open interactive presentation of Rocksurv Classifier">
                  <div class="showcase-device showcase-dual">
                    <div class="device-phone phone-primary">
                      <div class="phone-screen-wrap">
                        <span class="phone-tag">Schmidt Net (beta-axis)</span>
                        <img
                          src="/presentations/classifier/08-1000.webp"
                          srcset="/presentations/classifier/08-600.webp 600w, /presentations/classifier/08-1000.webp 1000w, /presentations/classifier/08-1600.webp 1600w"
                          sizes="(max-width: 900px) 46vw, 280px"
                          width="600"
                          height="1200"
                          alt="Rocksurv Classifier: equal-area Schmidt net with intersection of S0 and Fault planes, poles and calculated beta-axis"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div class="device-phone phone-secondary">
                      <div class="phone-screen-wrap">
                        <span class="phone-tag">IUGS QAPF (Plutonic)</span>
                        <img
                          src="/presentations/classifier/11-1000.webp"
                          srcset="/presentations/classifier/11-600.webp 600w, /presentations/classifier/11-1000.webp 1000w, /presentations/classifier/11-1600.webp 1600w"
                          sizes="(max-width: 900px) 46vw, 280px"
                          width="600"
                          height="1200"
                          alt="Rocksurv Classifier: Streckeisen QAPF double triangle classification with monzogranite field"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div class="showcase-badge-cta">
                      <span class="cta-pill cta-pill-cyan">
                        <Icon name="presentation" />
                        Interactive presentation: 10 slides &rarr;
                      </span>
                    </div>
                  </div>
                </a>
              )}
              <figcaption>{figureCaption[isPetrography ? 'petrography' : isCore ? 'core' : isField ? 'field-flow' : 'stereonet']}</figcaption>
            </figure>
            <div class="app-copy">
              <p class="app-stage" data-reveal>{String(index + 1).padStart(2, '0')}. {app.data.area}</p>
              <h3 id={`app-title-${app.id}`} data-reveal style={`--i:1; view-transition-name: app-${app.data.slug}`}>{app.data.title}</h3>
              <p class="app-summary" data-reveal style="--i:2">{app.data.summary}</p>
              <ul class="app-points">
                {app.data.highlights.map((item, k) => <li data-reveal style={`--i:${k + 2}`}>{item}</li>)}
              </ul>
              <div class="app-meta" data-reveal style="--i:5">
                {app.data.specVersion && <span class="chip">Specification {app.data.specVersion}</span>}
                {app.data.stack && <span class="chip">{app.data.stack}</span>}
                {app.data.statusNote && <span class="chip chip-accent">{app.data.statusNote}</span>}
                <span class="chip chip-accent">{isCore ? 'Offline architecture' : '100% Offline-First'}</span>
              </div>
              <div class="app-actions" data-reveal style="--i:6">
                <a class="app-pres-cta" href={`/en/presentations/${presentation.key}/`}>
                  <div class="app-pres-cta-content">
                    <div class="app-pres-cta-top">
                      <span class="app-pres-cta-badge">Interactive Review</span>
                      <span class="app-pres-cta-slides">{`${presentation.slides} slides${presentation.carousels ? ' · Carousels' : ''}`}</span>
                    </div>
                    <div class="app-pres-cta-title">
                      <Icon name="presentation" />
                      <strong>Explore real application capabilities</strong>
                      <span class="app-pres-cta-arrow" aria-hidden="true">&rarr;</span>
                    </div>
                    <p class="app-pres-cta-desc">
                      {isPetrography
                        ? 'Explore optical identification, paired PPL/XPL images, the Michel-Lévy chart and the virtual practice lab'
                        : isCore
                        ? 'Explore the vector strip log, drillhole documentation workflow and development roadmap'
                        : isField
                        ? 'Explore GeoPackage offline maps, observation log, structural measurements and session export'
                        : 'Explore Schmidt stereonet, IUGS QAPF double triangle and geometric error prevention'}
                    </p>
                  </div>
                </a>
                <a class="app-link" href={`/en/apps/${app.data.slug}/`}>
                  <span>{isPetrography ? 'Features and workflow of' : isCore ? 'Capabilities and development stages of' : 'Detailed specification and architecture of'} {app.data.title}</span>
                  <Icon name="arrow-up-right" />
                </a>
              </div>
            </div>
          </article>
        );
      })}

      <div class="practice" data-reveal>
        <div class="practice-photo">
          <img src="/images/experience/gmas-tablet-1280.webp" srcset="/images/experience/gmas-tablet-640.webp 640w, /images/experience/gmas-tablet-1280.webp 1280w" sizes="(max-width: 900px) 90vw, 40vw" width="1280" height="960" loading="lazy" decoding="async" alt="Geologist with rugged tablet on traverse in Saudi Arabia" />
        </div>
        <div>
          <h3>From GMAS Practice</h3>
          <p>Two tools developed during the Arabian Shield mapping campaign.</p>
          <ul class="practice-list">
            {practice.map((tool) => (
              <li><strong>{tool.data.title}</strong><small>{tool.data.area}</small><p>{tool.data.summary}</p></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="achievements" aria-labelledby="achievements-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="achievements-title" data-reveal>Documents, Publications, Talks</h2>
        <p data-reveal style="--i:1">Commendations, professional credentials, academic background, scientific publications, and conference presentations.</p>
      </div>
      <div class="ach-grid">
        {awards.map((item, index) => (
          <article class:list={['ach-tile', { 'is-lead': index === 0 }]} data-reveal style={`--i:${index}`}>
            <header><Icon name={index === 0 ? 'medal' : 'certificate'} /><span class="num">{item.data.year}</span></header>
            <div>
              <h3>{item.data.title}</h3>
              <p>{item.data.organization}</p>
            </div>
          </article>
        ))}

        <div class="ach-block ach-papers" data-reveal>
          <h3><Icon name="article" />Publications</h3>
          {papers.map((item) => (
            <div class="paper">
              <span class="paper-year num">{item.data.year}</span>
              <strong>{item.data.title}</strong>
              <p>{joinSentences(item.data.authors ?? '', item.data.organization).replace(/([^.])$/, '$1.')}</p>
              {item.data.url && (
                <a class="doi" href={item.data.url} target="_blank" rel="noopener">DOI<Icon name="arrow-up-right" /><span class="visually-hidden">: {item.data.title}, opens in new tab</span></a>
              )}
            </div>
          ))}
        </div>

        <div class="ach-block ach-edu" data-reveal style="--i:1">
          <h3><Icon name="graduation" />Education</h3>
          {education.map((item) => (
            <div class="edu-item">
              <span class="paper-year num">{item.data.year}</span>
              <strong>{item.data.title}</strong>
              <p>{item.data.organization}</p>
              {item.data.detail && <p>{item.data.detail}</p>}
            </div>
          ))}
        </div>

        <div class="ach-block ach-certs" data-reveal>
          <h3><Icon name="certificate" />Certificates & Courses</h3>
          <div class="cert-row">
            {certificates.map((item) => (
              <div class="cert">
                <span class="num">{item.data.year}</span>
                <strong>{item.data.title}</strong>
                <p>{item.data.organization}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="ach-block ach-talks" data-reveal>
          <h3><Icon name="presentation" />Talks & Lectures</h3>
          <ol class="talks">
            {talks.map((item) => (
              <li class="talk">
                <span class="num">{item.data.year}{item.data.place ? `, ${item.data.place}` : ''}</span>
                <strong>{item.data.title}</strong>
                <p>{joinSentences(item.data.authors ?? item.data.organization, item.data.detail)}</p>
                {item.data.file && (
                  <a class="talk-file" href={item.data.file} target="_blank" rel="noopener">
                    <Icon name="file-pdf" /><span>Presentation</span><small>PDF, {fileSize(item.data.file)}</small>
                    <span class="visually-hidden">: {item.data.title}, opens in new tab</span>
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
  <Lightbox lang="en" />
</BaseLayout>
