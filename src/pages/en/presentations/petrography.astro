            <div class="carousel-nav">
              <button class="carousel-btn prev" aria-label="Previous image">‹</button>
              <div class="carousel-dots">
                <button class="carousel-dot active" data-goto="0" aria-label="Go to state 1"></button><button class="carousel-dot" data-goto="1" aria-label="Go to state 2"></button><button class="carousel-dot" data-goto="2" aria-label="Go to state 3"></button><button class="carousel-dot" data-goto="3" aria-label="Go to state 4"></button><button class="carousel-dot" data-goto="4" aria-label="Go to state 5"></button>
