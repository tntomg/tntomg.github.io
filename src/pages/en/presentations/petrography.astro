<nav class="controls" aria-label="Slide navigation">
  <button id="prevBtn" title="Previous Slide (Left Arrow)">‹ Prev</button>
  <output id="slideOut" aria-live="polite">1 / 12</output>
  <button id="nextBtn" title="Next Slide (Right Arrow)">Next ›</button>
  <button id="fsBtn" title="Toggle Fullscreen (F)">⛶ Fullscreen</button>
  <button id="printBtn" title="Print to 16:9 PDF (P)">⎙ Print</button>
</nav>

<script is:inline>
  (function() {
    const stage = document.getElementById('stage');
    const slides = Array.from(document.querySelectorAll('.slide'));
    const slideOut = document.getElementById('slideOut');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const fsBtn = document.getElementById('fsBtn');
    const printBtn = document.getElementById('printBtn');
    const isRu = false;
    let currentSlide = Math.min(slides.length-1, Math.max(0, (parseInt(location.hash.slice(1),10)||1)-1));

    function applyScale() {
      const scale = Math.min((window.innerWidth - 32) / 1600, (window.innerHeight - 134) / 900);
      stage.style.setProperty('--scale', scale);
    }
    window.addEventListener('resize', applyScale);
    applyScale();

    function showSlide(index) {
      if (index < 0) index = 0;
      if (index >= slides.length) index = slides.length - 1;
      currentSlide = index;
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === currentSlide);
        s.setAttribute('aria-hidden', i !== currentSlide);
      });
      slideOut.textContent = String(currentSlide + 1).padStart(2,'0') + ' / ' + slides.length;
      history.replaceState(null,'','#'+(currentSlide+1));
      document.querySelector('.petrography-language').href='/ru/presentations/petrography/#'+(currentSlide+1);
    }

    prevBtn.addEventListener('click', () => showSlide(currentSlide - 1));
    nextBtn.addEventListener('click', () => showSlide(currentSlide + 1));
    fsBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });
    printBtn.addEventListener('click', () => window.print());

    window.addEventListener('keydown', (e) => {
      if(e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        showSlide(currentSlide + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        showSlide(currentSlide - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        showSlide(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        showSlide(slides.length - 1);
      } else if (e.key === 'f' || e.key === 'F') {
        e.preventDefault();
        fsBtn.click();
      } else if (e.key === 'p' || e.key === 'P') {
        e.preventDefault();
        window.print();
      }
    });

    showSlide(currentSlide);

    // Modern Carousel Engine
    document.querySelectorAll('.carousel').forEach(carousel => {
      const items = Array.from(carousel.querySelectorAll('.carousel-item'));
      const dots = Array.from(carousel.querySelectorAll('.carousel-dot'));
      const titleEl = carousel.querySelector('.badge-title .title-text');
      const countEl = carousel.querySelector('.badge-count');
      const prevCBtn = carousel.querySelector('.carousel-btn.prev');
      const nextCBtn = carousel.querySelector('.carousel-btn.next');
      const progressBar = carousel.querySelector('.cycle-progress');
      const total = items.length;
      if (total <= 1) return;

      let current = 0;

      let progressTimer = null;
      let progressVal = 0;
      const cycleDuration = 4800;

      function setItem(idx) {
        current = (idx + total) % total;
        items.forEach((item, i) => item.classList.toggle('active', i === current));
        dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
        const activeItem = items[current];
        if (titleEl && activeItem) {
          titleEl.textContent = activeItem.getAttribute('data-title') || '';
        }
        if (countEl) {
          countEl.textContent = isRu ? ((current + 1) + ' из ' + total) : ((current + 1) + ' of ' + total);
        }
        resetProgress();
      }

      function nextItem() { setItem(current + 1); }
      function prevItem() { setItem(current - 1); }

      function resetProgress() {
        progressVal = 0;
        if (progressBar) progressBar.style.width = '0%';
      }

      function startCycle() {
        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        stopCycle();
        const interval = 50;
        const step = (interval / cycleDuration) * 100;
        progressTimer = setInterval(() => {
          progressVal += step;
          if (progressBar) progressBar.style.width = Math.min(progressVal, 100) + '%';
          if (progressVal >= 100) {
            nextItem();
          }
        }, interval);
      }

      function stopCycle() {
        if (progressTimer) clearInterval(progressTimer);
        progressTimer = null;
      }

      if (prevCBtn) prevCBtn.addEventListener('click', (e) => { e.stopPropagation(); prevItem(); startCycle(); });
      if (nextCBtn) nextCBtn.addEventListener('click', (e) => { e.stopPropagation(); nextItem(); startCycle(); });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          setItem(i);
          startCycle();
        });
      });

      carousel.addEventListener('mouseenter', stopCycle);
      carousel.addEventListener('mouseleave', startCycle);

      startCycle();
    });
  })();
</script>
