---
// Supplied Petrography deck, optimized media and site navigation.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>RockSurv Petrography | SUITE OVERVIEW</title>
  <style is:global>
    :root {
      --paper: #f8fafc;
      --paper-card: #ffffff;
      --ink: #07111b;
      --muted: #475569;
      --muted-light: #64748b;
      --accent: #0284c7;
      --cyan: #38bdf8;
      --cyan-deep: #0ea5e9;
      --line: #cbd5e1;
      --emerald: #059669;
      --gold: #d97706;
      --closing-bg: #edf5fb;
      --cover-bg: #07111b;
      --phone-w: 335px;
      --phone-h: 710px;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: #060e17;
      color: var(--ink);
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Roboto', Arial, sans-serif;
      overflow: hidden;
    }
    button { font: inherit; }

    #stage {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 1600px;
      height: 900px;
      transform: translate(-50%, -50%) scale(var(--scale, 1));
      transform-origin: center;
    }

    .slide {
      display: none;
      position: relative;
      width: 1600px;
      height: 900px;
      overflow: hidden;
      background: var(--paper);
      padding: 48px 70px;
    }
    .slide.active { display: block; }

    .brandline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 2px;
    }
    .brandline .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 26px;
      letter-spacing: -.5px;
      font-weight: 800;
      color: var(--ink);
    }
    .eyebrow {
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 2px;
      font-size: 15px;
    }

    h1, h2, h3, p { margin: 0; }
    h2 {
      font-weight: 750;
      letter-spacing: -1.5px;
      font-size: 45px;
      line-height: 1.14;
      margin: 16px 0 10px;
      max-width: 1060px;
      color: var(--ink);
    }
    .lead {
      font-size: 21px;
      line-height: 1.36;
      color: var(--muted);
      max-width: 1040px;
      margin-bottom: 16px;
    }

    .feature-content {
      position: relative;
      margin-top: 8px;
      display: block;
    }
    .copy {
      padding-top: 2px;
      max-width: 1040px;
    }
    .point {
      border-top: 1px solid var(--line);
      padding-top: 12px;
      margin-bottom: 14px;
    }
    .point h3 {
      margin: 0 0 4px;
      font-size: 22px;
      font-weight: 700;
      line-height: 1.16;
      letter-spacing: -.4px;
      color: var(--ink);
    }
    .point p {
      font-size: 18px;
      line-height: 1.34;
      color: var(--muted);
    }

    .metric-row {
      display: flex;
      gap: 12px;
      margin-top: 14px;
      margin-bottom: 10px;
    }
    .metric-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      border-radius: 999px;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
      font-size: 13.5px;
      font-weight: 700;
      letter-spacing: .4px;
      color: #1e293b;
    }
    .metric-badge.accent {
      background: rgba(2, 132, 199, 0.12);
      border-color: rgba(2, 132, 199, 0.35);
      color: #0369a1;
    }
    .metric-badge.emerald {
      background: rgba(16, 185, 129, 0.12);
      border-color: rgba(16, 185, 129, 0.35);
      color: #047857;
    }
    .metric-badge.amber {
      background: rgba(217, 119, 6, 0.12);
      border-color: rgba(217, 119, 6, 0.35);
      color: #b45309;
    }
    .metric-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }

    .caption {
      position: absolute;
      left: 70px;
      bottom: 52px;
      width: 1040px;
      margin: 0;
      font-size: 16px;
      line-height: 1.35;
      color: var(--muted-light);
      font-style: italic;
    }

    .footer {
      position: absolute;
      left: 70px;
      right: 70px;
      bottom: 18px;
      border-top: 1px solid var(--line);
      padding-top: 8px;
      display: flex;
      justify-content: space-between;
      font-size: 14.5px;
      letter-spacing: .4px;
      color: var(--muted);
    }

    /* Portrait visual layout with Mobile Carousel */
    .portrait-visual {
      position: absolute;
      right: 70px;
      top: 86px;
      width: var(--phone-w);
      height: var(--phone-h);
    }

    .carousel {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 28px;
      overflow: hidden;
      background: #060e17;
      box-shadow: 0 20px 48px rgba(7, 17, 27, 0.35);
      outline: 2px solid #cbd5e1;
      user-select: none;
    }
    .carousel-track {
      position: relative;
      width: 100%;
      height: 100%;
    }
    .carousel-item {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity .45s cubic-bezier(.4, 0, .2, 1), transform .45s cubic-bezier(.4, 0, .2, 1);
      transform: translateX(16px) scale(0.985);
    }
    .carousel-item.active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
      z-index: 2;
    }
    .carousel-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Phone Speaker / Dynamic Island Top Notch */
    .device-notch {
      position: absolute;
      top: 9px;
      left: 50%;
      transform: translateX(-50%);
      width: 76px;
      height: 4px;
      background: rgba(255, 255, 255, 0.28);
      border-radius: 4px;
      z-index: 10;
    }

    /* Pill state badge on top */
    .state-badge {
      position: absolute;
      top: 18px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(6, 14, 23, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(56, 189, 248, 0.45);
      border-radius: 8px;
      padding: 6px 11px;
      color: #f0f7ff;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .3px;
      z-index: 5;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }
    .state-badge .badge-title {
      color: var(--cyan);
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 215px;
    }
    .state-badge .badge-title .indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 6px var(--cyan);
      flex-shrink: 0;
    }
    .state-badge .badge-count {
      color: #94a3b8;
      font-size: 11.5px;
      margin-left: 8px;
      flex-shrink: 0;
      font-weight: 700;
    }

    /* Subtle bottom gradient to feather screenshot bottom into device bezel */
    .carousel-bottom-gradient {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 52px;
      background: linear-gradient(to top, rgba(6, 14, 23, 0.95) 0%, rgba(6, 14, 23, 0.5) 60%, transparent 100%);
      z-index: 5;
      pointer-events: none;
    }

    /* Controls overlay at bottom of phone */
    .carousel-nav {
      position: absolute;
      bottom: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 6;
      background: rgba(6, 14, 23, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(211, 224, 236, 0.28);
      border-radius: 20px;
      padding: 4px 10px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }
    .carousel-btn {
      background: transparent;
      border: 0;
      color: #e2e8f0;
      cursor: pointer;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      transition: all .2s ease;
    }
    .carousel-btn:hover {
      background: rgba(56, 189, 248, 0.25);
      color: #38bdf8;
    }
    .carousel-dots {
      display: flex;
      gap: 5px;
      align-items: center;
    }
    .carousel-dot {
      width: 7px;
      height: 7px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transition: all .25s ease;
      border: none;
      padding: 0;
    }
    .carousel-dot.active {
      width: 20px;
      background: var(--cyan);
    }

    /* Auto-cycle indicator bar */
    .cycle-progress {
      position: absolute;
      bottom: 0;
      left: 0;
      height: 3px;
      background: var(--cyan);
      width: 0%;
      z-index: 7;
      transition: width 0.1s linear;
    }

    /* Single-item showcase (clean frame without carousel controls) */
    .carousel[data-count="1"] .carousel-nav,
    .carousel[data-count="1"] .cycle-progress,
    .carousel[data-count="1"] .badge-count,
    .carousel[data-count="1"] .carousel-bottom-gradient {
      display: none !important;
    }

    /* Cover Slide */
    .cover {
      background: radial-gradient(ellipse at 85% 20%, #15324d 0%, #0b1a28 55%, #07111b 100%);
      color: #f0f7ff;
    }
    .cover .brandline .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: #ffffff;
      font-size: 30px;
    }
    .cover .eyebrow, .cover .footer { color: #8bb2d4; }
    .cover .footer { border-color: #1e3a54; }
    .cover h1 {
      font-size: 80px;
      line-height: 1.05;
      letter-spacing: -3px;
      font-weight: 750;
      position: absolute;
      top: 175px;
      left: 70px;
      width: 900px;
      color: #ffffff;
    }
    .cover h1 span {
      display: block;
      color: var(--cyan);
    }
    .cover .tagline {
      position: absolute;
      top: 385px;
      left: 70px;
      width: 860px;
      font-size: 28px;
      line-height: 1.45;
      color: #d0e4f5;
    }
    .cover .cover-tags {
      position: absolute;
      top: 510px;
      left: 70px;
      width: 880px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .cover .cover-tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: 999px;
      background: rgba(14, 165, 233, 0.15);
      border: 1px solid rgba(56, 189, 248, 0.4);
      color: #e0f2fe;
      font-size: 16px;
      font-weight: 650;
      letter-spacing: .3px;
    }
    .cover .cover-tag-pill .pill-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
    }
    .cover .carousel {
      outline-color: #234b6e;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.65);
      background: #060e17;
    }
    .cover .caption {
      color: #9abedc;
      font-size: 16.5px;
    }

    /* Closing Slide */
    .closing {
      background: var(--closing-bg);
    }
    .closing .point {
      border-color: #c8dbeb;
    }

    /* Controls Bar */
    .controls {
      position: fixed;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: rgba(6, 14, 23, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 999px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      z-index: 100;
    }
    .controls button {
      background: transparent;
      color: #e2e8f0;
      border: 0;
      font-size: 14.5px;
      padding: 6px 12px;
      border-radius: 999px;
      cursor: pointer;
      transition: all .2s;
    }
    .controls button:hover {
      background: rgba(56, 189, 248, 0.25);
      color: var(--cyan);
    }
    .controls output {
      color: #cbd5e1;
      font-size: 14px;
      font-weight: 700;
      min-width: 65px;
      text-align: center;
      letter-spacing: .5px;
    }

    @media print {
      @page {
        size: 1600px 900px;
        margin: 0;
      }
      html, body {
        width: 1600px !important;
        height: auto !important;
        overflow: visible !important;
        background: #ffffff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      #stage {
        position: static !important;
        transform: none !important;
        width: 1600px !important;
        height: auto !important;
      }
      .slide {
        display: block !important;
        position: relative !important;
        width: 1600px !important;
        height: 900px !important;
        page-break-inside: avoid;
        break-after: page;
        page-break-after: always;
      }
      .slide:last-child {
        break-after: auto;
        page-break-after: auto;
      }
      .controls, .carousel-nav, .cycle-progress, .state-badge, .carousel-bottom-gradient {
        display: none !important;
      }
      .carousel-item {
        display: none;
      }
      .carousel-item:first-child {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        transform: none !important;
      }
    }
  
.petrography-topbar{position:fixed;inset:0 0 auto;height:52px;padding:8px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#0e1714;color:#f5f7f2;z-index:101;font-size:13px}
.petrography-topbar a{color:inherit;text-decoration:none;padding:8px 10px;border:1px solid #38584b;border-radius:6px}
.petrography-topbar a:hover,.petrography-topbar a:focus-visible{background:#244139;outline:2px solid #69d4ad;outline-offset:2px}
.petrography-actions{display:flex;gap:8px}.petrography-title{font-weight:700}
#stage{top:calc(50% - 15px)}.controls{max-width:calc(100vw - 16px);white-space:nowrap}
@media(max-width:640px){.petrography-title,#fsBtn,#printBtn{display:none}.petrography-topbar{padding-inline:8px}.controls{padding:4px 8px;gap:6px}.controls button{min-height:44px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
@media print{.petrography-topbar{display:none}}
@font-face{font-family:PetrographyBrand;src:url('/presentations/petrography/brand-font.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:block}
.petrography-name-fix{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}
</style>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
