---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import CoreShowcase from '../../../components/CoreShowcase.astro';
import PetrographyShowcase from '../../../components/PetrographyShowcase.astro';
import { appPresentation } from '../../../data/app-presentations';

export async function getStaticPaths() {
  const products = (await getCollection('apps', ({ data }) => data.publicationState === 'published' && data.kind === 'product')).sort((a, b) => a.data.order - b.data.order);
  return products.map((app, index) => ({
    params: { slug: app.data.slug! },
    props: { app, next: products[(index + 1) % products.length] },
  }));
}

interface Props {
  app: CollectionEntry<'apps'>;
  next: CollectionEntry<'apps'>;
}
const { app, next } = Astro.props;
const { data } = app;
const isField = (data.slug ?? '').includes('field');
const isCore = app.id === 'rocksurv-core';
const isPetrography = app.id === 'rocksurv-petrography';
const presentation = appPresentation(data.slug!);

const caption: Record<string, string> = {
  field: 'Интерфейс Rocksurv Field на полевом защищённом планшете: геопривязанные слои GeoPackage, активная сессия с точками наблюдения и навигация.',
  petrography: 'Экраны Android-приложения RockSurv Petrography: оптический определитель минералов и атлас шлифов со снимками PPL/XPL.',
  core: 'Прототип графического движка Rocksurv Core: интерактивная геологическая колонка и литологические знаки.',
  classifier: 'Интерфейс Rocksurv Classifier на смартфоне: равноплощадная сетка Шмидта с расчётом оси пересечения плоскостей (β-ось) и двойной треугольник QAPF Штрекайзена по стандарту IUGS.',
};
---
<BaseLayout title={`${data.title}: ${data.area.toLowerCase()} | Алексей Пахалко`} description={data.summary} active="apps" theme="night">
  <article class="case shell">
    <nav class="crumbs" aria-label="Навигационная цепочка"><a href="/ru/">Главная</a><span aria-hidden="true">/</span><a href="/ru/#apps">Приложения</a><span aria-hidden="true">/</span><span aria-current="page">{data.title}</span></nav>

    <header class="case-head">
      <div>
        <p class="app-stage">{data.stage}. {data.area}</p>
        <h1 style={`view-transition-name: app-${data.slug}`}>{data.title}</h1>
        <p class="case-lead">{data.summary}</p>
      </div>
      <dl class="case-facts">
        {data.specVersion && <div><dt>Спецификация</dt><dd>версия {data.specVersion}</dd></div>}
        {data.stack && <div><dt>Технологии</dt><dd>{data.stack}</dd></div>}
        {data.statusNote && <div><dt>Этап</dt><dd>{data.statusNote}</dd></div>}
        <div><dt>Автономность</dt><dd>{isCore ? 'Офлайн-архитектура MVP' : '100% Offline-First'}</dd></div>
        <div>
          <dt>Презентация</dt>
          <dd>
            <a href={`/ru/presentations/${presentation.key}/`} class="case-pres-link">
              <Icon name="presentation" />
              <span>Открыть ({`${presentation.slides} слайдов`})</span>
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <figure class="case-figure" style={`view-transition-name: figure-${data.slug}`}>
      <div class="figure-pres-bar">
        <a href={`/ru/presentations/${presentation.key}/`} class="figure-pres-btn">
          <Icon name="presentation" />
          <span>Интерактивная презентация приложения ({`${presentation.slides} слайдов`}) &rarr;</span>
        </a>
      </div>
      {isPetrography ? (<PetrographyShowcase lang="ru" />) : isCore ? (<CoreShowcase lang="ru" />) : isField ? (
        <a href="/ru/presentations/field/" class="app-showcase-link" aria-label="Открыть интерактивную презентацию Rocksurv Field">
          <div class="showcase-device showcase-tablet">
            <div class="device-bezel">
              <div class="device-camera-dot"></div>
              <div class="device-screen">
                <img
                  src="/presentations/field/01-1280.webp"
                  srcset="/presentations/field/01-800.webp 800w, /presentations/field/01-1280.webp 1280w, /presentations/field/01-1920.webp 1920w"
                  sizes="(max-width: 900px) 92vw, 560px"
                  width="1280"
                  height="705"
                  alt="Интерфейс Rocksurv Field на полевом защищённом планшете: геопривязанные слои GeoPackage, активная сессия и навигация"
                  loading="lazy"
                  decoding="async"
                  class="tablet-screen-img"
                />
                <div class="device-screen-overlay"></div>
              </div>
              <div class="showcase-chip-photo">
                <img
                  src="/presentations/field/16-640.webp"
                  width="140"
                  height="90"
                  alt="Полевая работа с планшетом на обнажении"
                  loading="lazy"
                  decoding="async"
                />
                <div class="chip-text">
                  <span class="chip-title">В полевом маршруте</span>
                  <span class="chip-sub">100% Offline-First</span>
                </div>
              </div>
            </div>
          </div>
        </a>
      ) : (
        <a href="/ru/presentations/classifier/" class="app-showcase-link" aria-label="Открыть интерактивную презентацию Rocksurv Classifier">
          <div class="showcase-device showcase-dual">
            <div class="device-phone phone-primary">
              <div class="phone-screen-wrap">
                <span class="phone-tag">Сетка Шмидта (β-ось)</span>
                <img
                  src="/presentations/classifier/08-1000.webp"
                  srcset="/presentations/classifier/08-600.webp 600w, /presentations/classifier/08-1000.webp 1000w, /presentations/classifier/08-1600.webp 1600w"
                  sizes="(max-width: 900px) 46vw, 280px"
                  width="600"
                  height="1200"
                  alt="Rocksurv Classifier: равноплощадная сетка Шмидта с пересечением плоскостей S0 и Fault, полюсами и расчётом бета-оси"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="device-phone phone-secondary">
              <div class="phone-screen-wrap">
                <span class="phone-tag">IUGS QAPF (Плутониты)</span>
                <img
                  src="/presentations/classifier/11-1000.webp"
                  srcset="/presentations/classifier/11-600.webp 600w, /presentations/classifier/11-1000.webp 1000w, /presentations/classifier/11-1600.webp 1600w"
                  sizes="(max-width: 900px) 46vw, 280px"
                  width="600"
                  height="1200"
                  alt="Rocksurv Classifier: классификационный двойной треугольник QAPF Штрекайзена с полем монцогранита"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </a>
      )}
      <figcaption>{caption[isPetrography ? 'petrography' : isCore ? 'core' : isField ? 'field' : 'classifier']}</figcaption>
    </figure>

    <section class="case-section" aria-labelledby="problem">
      <h2 id="problem">Зачем</h2>
      <p>{data.problem}</p>
    </section>

    <section class="case-section" aria-labelledby="workflow">
      <h2 id="workflow">{isCore ? 'Целевой сценарий' : 'Сценарий'}</h2>
      <ol class="steps">{data.workflow.map((step) => <li><p>{step}</p></li>)}</ol>
    </section>

    {data.capabilities.length > 0 && (
      <section class="case-section" aria-labelledby="capabilities">
        <h2 id="capabilities">{isPetrography ? 'Возможности приложения' : isCore ? 'Готовый движок и план разработки' : 'Что заложено в спецификацию'}</h2>
        <div class="caps">
          {data.capabilities.map((group) => (
            <div class="cap">
              <h3>{group.group}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <nav class="case-nav" aria-label="Другие приложения">
      <a href="/ru/#apps"><Icon name="arrow-left" />Все приложения</a>
      {next.id !== app.id && <a href={`/ru/apps/${next.data.slug}/`}>{next.data.title}<Icon name="arrow-right" /></a>}
    </nav>
  </article>
</BaseLayout>
