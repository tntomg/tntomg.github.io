---
// Supplied Core presentation, with optimized assets and site navigation.
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RockSurv Core | Презентация платформы документирования керна и выработок</title>
<style is:global>

:root {
  --bg-stage: #0a1713;
  --paper: #f7f9f6;
  --paper-subtle: #edf3ef;
  --paper-card: #ffffff;
  --ink: #0d2620;
  --ink-secondary: #244139;
  --muted: #4e675f;
  --muted-light: #708a82;
  --line: #d3dfd7;
  --line-light: #e6eee8;
  --mint: #2ec991;
  --mint-dark: #127954;
  --mint-bg: rgba(46, 201, 145, 0.12);
  --gold: #c99c3a;
  --gold-dark: #8e6c1e;
  --gold-bg: rgba(201, 156, 58, 0.12);
  --danger-bg: rgba(231, 76, 60, 0.1);
  --danger-text: #c0392b;
  --shadow-sm: 0 2px 8px rgba(13, 38, 32, 0.04);
  --shadow-md: 0 8px 24px -2px rgba(13, 38, 32, 0.06), 0 2px 6px rgba(13, 38, 32, 0.02);
  --shadow-lg: 0 16px 40px -4px rgba(13, 38, 32, 0.09);
  --shadow-device: 0 24px 60px -8px rgba(0, 0, 0, 0.38), 0 6px 18px rgba(0, 0, 0, 0.15);
}

* { box-sizing: border-box; }
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: var(--bg-stage);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}
button { font: inherit; }

#stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1600px;
  height: 900px;
  transform: translate(-50%, -50%) scale(var(--scale, 1));
  transform-origin: center;
  box-shadow: 0 24px 90px rgba(0, 0, 0, 0.65);
  background: var(--paper);
  border-radius: 4px;
}

.slide {
  display: none;
  position: relative;
  width: 1600px;
  height: 900px;
  overflow: hidden;
  background: var(--paper);
  padding: 44px 60px 72px 60px;
}
.slide.active { display: flex; flex-direction: column; }

/* Brandline */
.brandline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  border-bottom: 1px solid var(--line-light);
  padding-bottom: 10px;
}
.brandline .brand {
  font-size: 20px;
  letter-spacing: -0.5px;
  font-weight: 800;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8px;
}
.brandline .brand span { color: var(--mint-dark); }
.brandline .eyebrow {
  font-size: 12px;
  letter-spacing: 1.5px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--muted);
}
.brandline .tag {
  background: var(--paper-subtle);
  border: 1px solid var(--line);
  padding: 3px 12px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 650;
  color: var(--ink-secondary);
}

/* Header */
.slide-header {
  margin-bottom: 20px;
}
.slide-kicker {
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--mint-dark);
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.slide-kicker::before {
  content: "";
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--mint);
}
h1, h2, h3, p { margin: 0; }
h2 {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -1.1px;
  line-height: 1.15;
  color: var(--ink);
  margin-bottom: 6px;
}
.lead {
  font-size: 17px;
  line-height: 1.45;
  color: var(--muted);
  max-width: 1420px;
}

/* Content Area */
.content-grid {
  flex: 1;
  display: grid;
  gap: 24px;
  min-height: 0;
}

/* Cards */
.card {
  background: var(--paper-card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 22px 24px;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  position: relative;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.card-title {
  font-size: 18px;
  font-weight: 750;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8px;
}
.card-subtitle {
  font-size: 13.5px;
  color: var(--muted);
  line-height: 1.4;
  margin-bottom: 14px;
}

/* Badges */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}
.pill-mint { background: var(--mint-bg); color: var(--mint-dark); border: 1px solid rgba(46, 201, 145, 0.3); }
.pill-gold { background: var(--gold-bg); color: var(--gold-dark); border: 1px solid rgba(201, 156, 58, 0.3); }
.pill-danger { background: var(--danger-bg); color: var(--danger-text); border: 1px solid rgba(231, 76, 60, 0.3); }
.pill-neutral { background: var(--paper-subtle); color: var(--muted); border: 1px solid var(--line); }

/* Feature Items */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14.5px;
  line-height: 1.42;
  color: var(--ink);
}
.feature-item .icon {
  flex-shrink: 0;
  margin-top: 2px;
}
.feature-item strong {
  font-weight: 700;
  color: var(--ink);
}

/* Stats */
.stat-box {
  background: var(--paper-subtle);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 14px 18px;
  display: flex;
  flex-direction: column;
}
.stat-num {
  font-size: 28px;
  font-weight: 850;
  letter-spacing: -0.8px;
  color: var(--ink);
  line-height: 1;
  margin-bottom: 4px;
}
.stat-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--muted);
}

/* Devices */
.device-tablet {
  background: #0f1c18;
  border-radius: 16px;
  padding: 8px;
  box-shadow: var(--shadow-device);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
}
.device-tablet .tablet-lens {
  width: 5px;
  height: 5px;
  background: #254037;
  border-radius: 50%;
  margin: 0 auto 5px;
}
.device-tablet .screen {
  border-radius: 9px;
  overflow: hidden;
  background: #000;
  flex: 1;
  display: flex;
}
.device-tablet img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.device-phone {
  background: #0d1714;
  border-radius: 26px;
  padding: 6px;
  box-shadow: var(--shadow-device);
  border: 2px solid #233c34;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.device-phone .notch {
  width: 60px;
  height: 8px;
  background: #000;
  border-radius: 6px;
  margin-bottom: 5px;
}
.device-phone .screen {
  border-radius: 18px;
  overflow: hidden;
  background: #000;
  width: 100%;
}
.device-phone img {
  display: block;
  width: 100%;
  height: auto;
}

/* Nav Bar */
#nav-bar {
  position: fixed;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 27, 23, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 9999px;
  padding: 5px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  z-index: 1000;
}
.nav-btn {
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 5px 12px;
  border-radius: 9999px;
  font-size: 12.5px;
  font-weight: 650;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s ease;
}
.nav-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  color: var(--mint);
}
.nav-counter {
  color: rgba(255, 255, 255, 0.65);
  font-size: 12.5px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  padding: 0 4px;
}
.nav-dots {
  display: flex;
  gap: 5px;
  align-items: center;
}
.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  cursor: pointer;
  transition: all 0.2s ease;
}
.dot.active {
  background: var(--mint);
  width: 18px;
  border-radius: 9999px;
}
.nav-divider {
  width: 1px;
  height: 16px;
  background: rgba(255, 255, 255, 0.18);
}
.lang-toggle {
  background: rgba(46, 201, 145, 0.16);
  border: 1px solid rgba(46, 201, 145, 0.45);
  color: var(--mint);
  padding: 3px 9px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 800;
  text-decoration: none;
  letter-spacing: 0.5px;
  transition: all 0.15s ease;
}
.lang-toggle:hover {
  background: var(--mint);
  color: #0a1713;
}

@media print {
  body { background: #fff; }
  #stage { position: static; transform: none; box-shadow: none; width: 100%; height: auto; }
  .slide { display: flex !important; page-break-after: always; height: 100vh; }
  #nav-bar { display: none !important; }
}


.core-topbar { position:fixed; inset:0 0 auto; height:52px; padding:8px 16px; display:flex; align-items:center; justify-content:space-between; gap:16px; color:#f5f7f2; background:#0e1714; border-bottom:1px solid #244139; z-index:1001; font-size:13px; }
.core-back { color:inherit; padding:8px 10px; text-decoration:none; border:1px solid #38584b; border-radius:6px; }
.core-back:hover, .core-back:focus-visible { background:#244139; outline:2px solid #69d4ad; outline-offset:2px; }
.core-title { font-weight:700; }
#stage { top:calc(50% - 15px); }
#nav-bar { max-width:calc(100vw - 16px); white-space:nowrap; }
#nav-dots .dot { padding:0; cursor:pointer; }
#nav-dots .dot:focus-visible { outline:2px solid #69d4ad; outline-offset:3px; }
@media (max-width:900px) { #nav-dots, .nav-divider { display:none; } }
@media (max-width:640px) { #btn-fs, #btn-print, .core-title { display:none; } #nav-bar { gap:6px; padding:4px 8px; } .nav-btn { min-height:44px; padding:6px 8px; } .core-topbar { padding-inline:8px; gap:8px; } }
@media print { .core-topbar { display:none; } }
</style>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
<header class="core-topbar"><a class="core-back" href="/ru/#apps">Назад к приложениям</a><span class="core-title">Rocksurv Core</span><span>14 слайдов</span></header>
<div id="stage">

    <section class="slide active" aria-label="1. RockSurv Core">
      <div class="brandline">
        <div class="brand">ROCKSURV <span>CORE</span></div>
        <div class="eyebrow">МОБИЛЬНАЯ ПЛАТФОРМА ГЕОЛОГИЧЕСКОГО ДОКУМЕНТИРОВАНИЯ</div>
        <div class="tag">FLUTTER &bull; IOS &bull; ANDROID &bull; WEB</div>
      </div>
      <div class="slide-header" style="margin-bottom: 28px;">
        <div class="slide-kicker">РУДНАЯ ГРР &bull; КЕРНОХРАНИЛИЩА &bull; ГОРНЫЕ ВЫРАБОТКИ</div>
        <h2 style="font-size: 46px; margin-bottom: 12px;">RockSurv <span style="color: var(--mint-dark);">Core</span></h2>
        <p class="lead" style="font-size: 21px; max-width: 1200px;">
          Высокопроизводительное мобильное приложение для документирования бурового керна и горных выработок. Процедурные векторные знаки по ГОСТ 2.857-75 со скоростью 60 FPS в 100% офлайн-режиме.
        </p>
      </div>
      <div class="content-grid" style="grid-template-columns: 1.15fr 0.85fr; align-items: center;">
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            <span class="pill pill-mint">100% Офлайн-Архитектура (ACID SQLite)</span>
            <span class="pill pill-mint">Векторный движок ГОСТ 2.857-75</span>
            <span class="pill pill-mint">Каротажная колонка 60 FPS (2 000 м)</span>
            <span class="pill pill-gold">Экспорт в Leapfrog &bull; Micromine &bull; Datamine</span>
          </div>
          <div class="card" style="padding: 22px;">
            <div class="card-title" style="margin-bottom: 8px;">Прямой конвейер: Кернохранилище &rarr; 3D-модель</div>
            <p style="font-size: 14.5px; color: var(--muted); line-height: 1.5; margin-bottom: 16px;">
              Создано специально для рудной геологоразведки, кернохранилищ и подземных забоев. Полностью устраняет двойной ввод, полевые журналы и ошибки в интервалах глубин.
            </p>
            <div style="display: flex; gap: 20px; align-items: center;">
              <div class="stat-box" style="flex: 1;">
                <div class="stat-num" style="color: var(--mint-dark);">60 FPS</div>
                <div class="stat-label">Аппаратный рендеринг колонки керна</div>
              </div>
              <div class="stat-box" style="flex: 1;">
                <div class="stat-num" style="color: var(--gold-dark);">&lt; 5 минут</div>
                <div class="stat-label">От документирования до блочной модели</div>
              </div>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 24px;">
            <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted);">Платформы:</div>
            <div style="display: flex; align-items: center; gap: 14px;">
              <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 650; color: var(--ink);"><svg fill="#2ec991" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"/></svg> Android</div>
              <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 650; color: var(--ink);"><svg fill="#2ec991" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg> iOS</div>
              <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 650; color: var(--ink);"><svg fill="#2ec991" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg> Web</div>
            </div>
          </div>
        </div>
        <div style="position: relative; height: 490px; display: flex; align-items: center; justify-content: center;">
          <div class="device-tablet" style="width: 520px; height: 350px;">
            <div class="tablet-lens"></div>
            <div class="screen"><img src="/presentations/core/ru-01-1280.webp" alt="Каротажная колонка на планшете" srcset="/presentations/core/ru-01-640.webp 640w, /presentations/core/ru-01-1280.webp 1280w" sizes="(max-width: 900px) 90vw, 1000px" width="1280" height="800" loading="eager" decoding="async"></div>
          </div>
          <div class="device-phone" style="position: absolute; right: 10px; bottom: 15px; width: 175px;">
            <div class="notch"></div>
            <div class="screen"><img src="/presentations/core/ru-02-390.webp" alt="Мобильный интерфейс на телефоне" srcset="/presentations/core/ru-02-390.webp 390w" sizes="(max-width: 900px) 90vw, 1000px" width="390" height="844" loading="eager" decoding="async"></div>
          </div>
        </div>
      </div>
    </section>
    

    <section class="slide" aria-label="2. От кернохранилища и забоя &mdash; прямо в блочную модель">
      <div class="brandline">
        <div class="brand">ROCKSURV <span>CORE</span></div>
        <div class="eyebrow">ОПЕРАЦИОННАЯ ЭФФЕКТИВНОСТЬ</div>
        <div class="tag">СЛАЙД 02 / 14</div>
      </div>
      <div class="slide-header">
        <div class="slide-kicker">ОПТИМИЗАЦИЯ ПРОЦЕССА &bull; БЕЗ ДВОЙНОГО ВВОДА</div>
        <h2>От кернохранилища и забоя &mdash; прямо в блочную модель</h2>
        <p class="lead">Ликвидация разрыва между ручной полевой документацией в лагере и 3D-моделированием в камералке.</p>
      </div>
      <div class="content-grid" style="grid-template-columns: 1fr 1fr;">
        <div class="card" style="border-left: 4px solid #c0392b;">
          <div class="card-header">
            <div class="card-title">Классический ручной процесс</div>
            <span class="pill pill-danger">ВЫСОКИЙ РИСК &bull; ЗАДЕРЖКА 24&ndash;72 Ч</span>
          </div>
          <p class="card-subtitle">Бумажные журналы, вечерняя перепечатка и запоздалый контроль.</p>
