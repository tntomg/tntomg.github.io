      <button id="btn-next" class="nav-btn" title="Следующий слайд (Стрелка вправо или Пробел)">Вперёд &#8594;</button>
      <div class="nav-divider"></div>
      <button id="btn-fs" class="nav-btn" title="Полноэкранный режим (F)">&#x26F6; На весь экран</button>
      <button id="btn-print" class="nav-btn" title="Печать в PDF (Ctrl+P)">&#x2399; Печать / PDF</button>
      <div class="nav-divider"></div>
      <a href="/en/presentations/core/" class="lang-toggle" title="Switch to English version">EN</a>
    </div>
    
<script is:inline>

(function() {
  var slides = Array.from(document.querySelectorAll('.slide'));
  var dotsContainer = document.getElementById('nav-dots');
  var currentSlide = Math.min(slides.length - 1, Math.max(0, (parseInt(location.hash.slice(1), 10) || 1) - 1));

  slides.forEach(function(_, idx) {
    var dot = document.createElement('button');
    dot.className = 'dot' + (idx === 0 ? ' active' : '');
    dot.type = 'button';
    dot.title = (idx + 1).toString();
    dot.setAttribute('aria-label', 'Слайд ' + (idx + 1));
    dot.onclick = function() { goToSlide(idx); };
    dotsContainer.appendChild(dot);
  });

  function updateSlide() {
    slides.forEach(function(s, idx) {
      s.classList.toggle('active', idx === currentSlide);
      s.setAttribute('aria-hidden', idx !== currentSlide);
    });
    var dots = dotsContainer.querySelectorAll('.dot');
    dots.forEach(function(d, idx) {
      d.classList.toggle('active', idx === currentSlide);
    });
    var counter = document.getElementById('slide-counter');
    if (counter) {
      var num = (currentSlide + 1 < 10 ? '0' : '') + (currentSlide + 1);
      var total = (slides.length < 10 ? '0' : '') + slides.length;
      counter.textContent = num + ' / ' + total;
      history.replaceState(null, '', '#' + (currentSlide + 1));
      document.querySelector('a.lang-toggle').href = '/en/presentations/core/#' + (currentSlide + 1);
    }
  }

  function goToSlide(n) {
    if (n >= 0 && n < slides.length) {
      currentSlide = n;
      updateSlide();
    }
  }

  function nextSlide() { goToSlide((currentSlide + 1) % slides.length); }
  function prevSlide() { goToSlide((currentSlide - 1 + slides.length) % slides.length); }

  document.getElementById('btn-prev').onclick = prevSlide;
  document.getElementById('btn-next').onclick = nextSlide;
  document.getElementById('btn-fs').onclick = function() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(function() {});
    } else {
      document.exitFullscreen();
    }
  };
  document.getElementById('btn-print').onclick = function() { window.print(); };

  window.addEventListener('keydown', function(e) {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (['ArrowRight','ArrowLeft','PageDown','PageUp',' ','Home','End'].includes(e.key)) e.preventDefault();
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
      nextSlide();
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      prevSlide();
    } else if (e.key === 'Home') {
      goToSlide(0);
    } else if (e.key === 'End') {
      goToSlide(slides.length - 1);
    } else if (e.key === 'f' || e.key === 'F') {
      document.getElementById('btn-fs').click();
    }
  });

  var touchStartX = 0;
  window.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, {passive: true});
  window.addEventListener('touchend', function(e) {
    var diff = e.changedTouches[0].screenX - touchStartX;
    if (Math.abs(diff) > 50) {
      if (diff < 0) nextSlide();
      else prevSlide();
    }
  }, {passive: true});

  function resizeStage() {
    var stage = document.getElementById('stage');
    var scale = Math.min((window.innerWidth - 32) / 1600, (window.innerHeight - 134) / 900);
    stage.style.setProperty('--scale', scale);
  }
  window.addEventListener('resize', resizeStage);
  updateSlide();
  resizeStage();
})();

</script>
